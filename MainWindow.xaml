<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AppManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AppManager.Models">
    <Grid
        x:Name="RootGrid"
        Background="Transparent">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="AppTileItemStyle" TargetType="GridViewItem">
                <Setter Property="Width" Value="116" />
                <Setter Property="Height" Value="126" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </Grid.Resources>

        <!-- 窗口底色：Win11 由 DWM 原生圆角裁切，Win10 使用圆角 Border + 窗口区域回退。 -->
        <Border
            x:Name="WindowBackdropTint"
            Background="{ThemeResource WindowSurfaceBrush}"
            CornerRadius="27"
            IsHitTestVisible="False" />

        <Border
            x:Name="WindowFrame"
            Margin="0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="27">
            <Grid Padding="26,18,26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部搜索栏与主题切换 -->
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="SearchBar"
                        Grid.Column="1"
                        MaxWidth="540"
                        Height="54"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource SearchBarBackgroundBrush}"
                        BorderBrush="{ThemeResource SearchBarBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="27">
                        <Grid Margin="18,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="17"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Glyph="&#xE721;" />
                            <Grid Grid.Column="1">
                                <TextBlock
                                    x:Name="SearchPlaceholder"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                                    FontSize="15"
                                    Foreground="{ThemeResource TextMutedBrush}"
                                    IsHitTestVisible="False"
                                    Text="搜索本机应用…" />
                                <TextBox
                                    x:Name="SearchBox"
                                    Style="{StaticResource SearchInputStyle}"
                                    TextChanged="SearchBox_TextChanged"
                                    GotFocus="SearchBox_GotFocus"
                                    LostFocus="SearchBox_LostFocus"
                                    KeyDown="SearchBox_KeyDown" />
                            </Grid>
                            <Border
                                Grid.Column="2"
                                Height="22"
                                Padding="7,0"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SearchKeyBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource SearchKeyBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextMutedBrush}"
                                    Text="Enter" />
                            </Border>
                        </Grid>
                    </Border>

                    <Button
                        x:Name="ThemeToggleButton"
                        Grid.Column="2"
                        Height="38"
                        Padding="13,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ThemeToggleBackgroundBrush}"
                        BorderBrush="{ThemeResource ThemeToggleBorderBrush}"
                        BorderThickness="1"
                        Click="ThemeToggleButton_Click"
                        CornerRadius="19"
                        ToolTipService.ToolTip="切换界面主题：暗色 / 浅色 / 跟随系统">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="ThemeToggleIcon"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Glyph="&#xE708;" />
                            <TextBlock
                                x:Name="ThemeToggleText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="暗色" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 分类标签栏 -->
                <Grid Grid.Row="1" Height="36" Margin="0,14,0,0">
                    <ScrollViewer
                        HorizontalContentAlignment="Center"
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel
                            x:Name="CategoryPanel"
                            Orientation="Horizontal"
                            Spacing="8" />
                    </ScrollViewer>
                </Grid>

                <!-- 应用图标列表 -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <GridView
                        x:Name="AppsGrid"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        IsItemClickEnabled="True"
                        ItemClick="AppsGrid_ItemClick"
                        ItemContainerStyle="{StaticResource AppTileItemStyle}"
                        SelectionMode="None"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollMode="Enabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    ItemWidth="116"
                                    ItemHeight="126"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppItem">
                                <Grid
                                    Width="108"
                                    Height="120"
                                    Background="Transparent"
                                    RightTapped="AppTile_RightTapped"
                                    ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <Grid Width="58" Height="58" HorizontalAlignment="Center">
                                            <Border
                                                Background="{ThemeResource AppIconBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppIconBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="17" />
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="22"
                                                Foreground="{ThemeResource TextMutedBrush}"
                                                Glyph="&#xE8A5;" />
                                            <Image
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind IconSource, Mode=OneWay}"
                                                Stretch="Uniform" />
                                        </Grid>
                                        <TextBlock
                                            Width="98"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            LineHeight="15"
                                            MaxLines="2"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <StackPanel
                        x:Name="EmptyState"
                        Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        Visibility="Collapsed">
                        <Grid Width="66" Height="66" HorizontalAlignment="Center">
                            <Ellipse
                                Fill="{ThemeResource AppIconBackgroundBrush}"
                                Stroke="{ThemeResource AppIconBorderBrush}"
                                StrokeThickness="1" />
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="25"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Glyph="&#xE8B7;" />
                        </Grid>
                        <TextBlock
                            x:Name="EmptyTitle"
                            Margin="0,4,0,0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="收纳器还是空的"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="EmptyDescription"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="点击右下角「管理应用」添加应用，或在设置中扫描本机应用。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="EmptyActionButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Click="EmptyActionButton_Click"
                            Content="打开应用管理"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                    </StackPanel>
                </Grid>

                <!-- 底部状态栏与右下角操作 -->
                <Border
                    Grid.Row="3"
                    Height="48"
                    Margin="0,12,0,0"
                    Background="{ThemeResource FooterBackgroundBrush}"
                    BorderBrush="{ThemeResource FooterBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="24">
                    <Grid Padding="16,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                x:Name="StatusText"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="正在准备收纳器…" />
                            <Border
                                Width="1"
                                Height="12"
                                Background="{ThemeResource DividerBrush}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextMutedBrush}"
                                Text="单击启动 · 右键更多" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="SettingsButton"
                                Style="{StaticResource IconButtonStyle}"
                                Click="SettingsButton_Click"
                                ToolTipService.ToolTip="设置">
                                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE713;" />
                            </Button>
                            <Button
                                x:Name="ManageAppsButton"
                                Style="{StaticResource FooterActionButtonStyle}"
                                Click="ManageAppsButton_Click"
                                ToolTipService.ToolTip="添加、移除或整理应用">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE8B7;" />
                                    <TextBlock VerticalAlignment="Center" Text="管理应用" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 设置 / 应用管理浮层 -->
        <Grid
            x:Name="ModalLayer"
            Canvas.ZIndex="50"
            Visibility="Collapsed">
            <Rectangle
                Fill="{ThemeResource ModalScrimBrush}"
                Tapped="ModalScrim_Tapped" />
            <Border
                x:Name="ModalCard"
                Width="760"
                MaxHeight="530"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="22,16,16,14"
                        Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ModalTitleText"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="设置" />
                        <Button
                            x:Name="ModalCloseButton"
                            Grid.Column="1"
                            Click="ModalCloseButton_Click"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE711;" />
                        </Button>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource DividerBrush}"
                        BorderThickness="0,1,0,0">
                        <ContentControl
                            x:Name="ModalContentHost"
                            Margin="22,16,22,22"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
