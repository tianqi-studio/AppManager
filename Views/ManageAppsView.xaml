<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppManager.Views.ManageAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AppManager.Models">

    <UserControl.Resources>
        <Style x:Key="AppListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部搜索与添加 -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="AppSearchBox"
                Height="38"
                Padding="12,0"
                VerticalContentAlignment="Center"
                Background="{ThemeResource FieldBackgroundBrush}"
                BorderBrush="{ThemeResource FieldBorderBrush}"
                CornerRadius="9"
                FontSize="12"
                PlaceholderText="搜索名称或启动路径…"
                TextChanged="AppSearchBox_TextChanged" />

            <TextBlock
                x:Name="ListCountText"
                Grid.Column="1"
                Margin="4,0"
                VerticalAlignment="Center"
                Style="{StaticResource MutedTextStyle}"
                Text="共 0 个应用" />

            <Button
                x:Name="AddAppsButton"
                Grid.Column="2"
                Click="AddAppsButton_Click"
                Style="{StaticResource PrimaryActionButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE710;" />
                    <TextBlock VerticalAlignment="Center" Text="添加应用" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 应用列表与详情 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="5" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <ListView
                        x:Name="AppsList"
                        Background="Transparent"
                        BorderThickness="0"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource AppListItemStyle}"
                        SelectionChanged="AppsList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppItem">
                                <Grid Height="48" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid
                                        Width="34"
                                        Height="34"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Border
                                            Background="{ThemeResource AppIconBackgroundBrush}"
                                            BorderBrush="{ThemeResource AppIconBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10" />
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="14"
                                            Foreground="{ThemeResource TextMutedBrush}"
                                            Glyph="&#xE8A5;" />
                                        <Image
                                            Width="26"
                                            Height="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Source="{x:Bind IconSource, Mode=OneWay}"
                                            Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="1">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind Name, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource TextMutedBrush}"
                                            MaxLines="1"
                                            Text="{x:Bind LaunchTarget}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="ListEmptyState"
                        Width="260"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="Collapsed">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="24"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            x:Name="ListEmptyTitle"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="还没有收纳应用"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="ListEmptyHint"
                            HorizontalAlignment="Center"
                            Style="{StaticResource HintTextStyle}"
                            Text="点击右上角「添加应用」选择 exe 或快捷方式。"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="18" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <StackPanel
                            x:Name="DetailPanel"
                            Spacing="12"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Grid Width="56" Height="56">
                                    <Border
                                        Background="{ThemeResource AppIconBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppIconBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15" />
                                    <FontIcon
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="21"
                                        Foreground="{ThemeResource TextMutedBrush}"
                                        Glyph="&#xE8A5;" />
                                    <Image
                                        x:Name="DetailIconImage"
                                        Width="42"
                                        Height="42"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform" />
                                </Grid>
                                <StackPanel
                                    Width="190"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        x:Name="DetailNameText"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        MaxLines="2"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="DetailSourceText"
                                        Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                x:Name="DetailPathText"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="10"
                                Foreground="{ThemeResource TextMutedBrush}"
                                IsTextSelectionEnabled="True"
                                MaxLines="3"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <Border Height="1" Background="{ThemeResource DividerBrush}" />

                            <StackPanel Spacing="6">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="所属分类" />
                                <StackPanel x:Name="CategoryCheckList" Spacing="2" />
                                <TextBlock
                                    Style="{StaticResource HintTextStyle}"
                                    Text="可多选；应用至少保留一个分类。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Click="OpenDetailButton_Click"
                                    Content="打开应用"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryActionButtonStyle}" />
                                <Button
                                    x:Name="FolderDetailButton"
                                    Grid.Column="1"
                                    Click="FolderDetailButton_Click"
                                    Content="所在位置"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryActionButtonStyle}" />
                            </Grid>

                            <Button
                                Click="RemoveDetailButton_Click"
                                Content="从收纳器中移除"
                                Foreground="{ThemeResource DangerBrush}"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SecondaryActionButtonStyle}" />

                            <TextBlock
                                Style="{StaticResource MutedTextStyle}"
                                Text="移除只会让应用离开收纳器，不会卸载或删除应用文件。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel
                        x:Name="NoSelectionState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="26"
                            Foreground="{ThemeResource TextMutedBrush}"
                            Glyph="&#xE8B7;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="选择一个应用查看详情" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource HintTextStyle}"
                            Text="可以在这里调整分类或移除应用。"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <InfoBar
            x:Name="ManageInfoBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />
    </Grid>
</UserControl>
