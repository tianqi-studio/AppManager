<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AppManager.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Enabled">
        <StackPanel Padding="0,0,4,4" Spacing="12">

            <!-- 界面风格 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="界面风格" />
                        <TextBlock
                            Style="{StaticResource HintTextStyle}"
                            Text="暗色与浅色使用 WinUI 3 原生配色；跟随系统会随 Windows 的应用主题自动切换。" />
                    </StackPanel>
                    <ComboBox
                        x:Name="ThemeComboBox"
                        Grid.Column="1"
                        MinWidth="168"
                        VerticalAlignment="Center"
                        SelectionChanged="ThemeComboBox_SelectionChanged"
                        Style="{StaticResource FieldComboBoxStyle}">
                        <ComboBoxItem Content="暗色" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="跟随系统" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 全局快捷键 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="全局快捷键" />
                        <TextBlock
                            Style="{StaticResource HintTextStyle}"
                            Text="在任意界面按下快捷键即可呼出或收起收纳器。裸 R 不推荐，输入文字时可能误触。" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="7">
                        <ComboBox
                            x:Name="HotkeyComboBox"
                            MinWidth="168"
                            SelectionChanged="HotkeyComboBox_SelectionChanged"
                            Style="{StaticResource FieldComboBoxStyle}">
                            <ComboBoxItem Content="Ctrl + R" />
                            <ComboBoxItem Content="Alt + R" />
                            <ComboBoxItem Content="R" />
                            <ComboBoxItem Content="Ctrl + Space" />
                        </ComboBox>
                        <TextBlock
                            x:Name="HotkeyStatusText"
                            HorizontalAlignment="Right"
                            Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 窗口尺寸 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="窗口尺寸" />
                        <TextBlock
                            Style="{StaticResource HintTextStyle}"
                            Text="窗口会固定在当前屏幕工作区的底部上方。宽屏适合展示更多应用图标。" />
                    </StackPanel>
                    <ComboBox
                        x:Name="SizeComboBox"
                        Grid.Column="1"
                        MinWidth="168"
                        VerticalAlignment="Center"
                        SelectionChanged="SizeComboBox_SelectionChanged"
                        Style="{StaticResource FieldComboBoxStyle}">
                        <ComboBoxItem Content="紧凑 · 760 × 500" Tag="760x500" />
                        <ComboBoxItem Content="标准 · 900 × 560" Tag="900x560" />
                        <ComboBoxItem Content="宽屏 · 1000 × 600" Tag="1000x600" />
                        <ComboBoxItem Content="大屏 · 1200 × 720" Tag="1200x720" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 扫描本机应用 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="本机应用" />
                            <TextBlock
                                Style="{StaticResource HintTextStyle}"
                                Text="从开始菜单和 Windows 商店中扫描应用。首次启动不会自动扫描，只有点击按钮时才会执行。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <Button
                                x:Name="CancelScanButton"
                                Click="CancelScanButton_Click"
                                Content="取消"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="ScanButton"
                                Click="ScanButton_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE721;" />
                                    <TextBlock VerticalAlignment="Center" Text="扫描本机应用" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ProgressBar
                        x:Name="ScanProgressBar"
                        Height="3"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />

                    <StackPanel Spacing="3">
                        <TextBlock
                            x:Name="ScanStatusText"
                            Style="{StaticResource HintTextStyle}"
                            Text="扫描会读取快捷方式和应用包信息，通常需要几秒钟。" />
                        <TextBlock
                            x:Name="ScanDetailText"
                            Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>

                    <InfoBar
                        x:Name="ScanInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational" />
                </StackPanel>
            </Border>

            <!-- 数据目录 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="数据与日志" />
                        <TextBlock
                            Style="{StaticResource HintTextStyle}"
                            Text="分类、应用和设置都会保存在本机 JSON 文件中，卸载程序前可以先备份这里的数据。" />
                    </StackPanel>
                    <TextBlock
                        x:Name="DataPathText"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextMutedBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="OpenDataFolderButton_Click"
                            Content="打开数据目录"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                        <Button
                            Click="OpenLogButton_Click"
                            Content="查看运行日志"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Style="{StaticResource MutedTextStyle}"
                Text="应用收纳器 · 所有数据仅保存在本机" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
